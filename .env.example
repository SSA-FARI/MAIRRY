# Application
APP_ENV=local
DEMO_USER_ID=00000000-0000-0000-0000-000000000001
DEMO_WEDDING_PLAN_ID=00000000-0000-0000-0000-000000000002
DEMO_MEMBER_ID=00000000-0000-0000-0000-000000000003
DEMO_USER_LOGIN_ID=demo
DEMO_USER_DISPLAY_NAME=Demo User
DEMO_USER_EMAIL=
CORS_ORIGINS=http://localhost:3000

# Database
DATABASE_URL=postgresql+psycopg://mairry:mairry@localhost:5432/mairry
POSTGRES_DB=mairry
POSTGRES_USER=mairry
POSTGRES_PASSWORD=mairry

# Object storage
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=mairry
OBJECT_STORAGE_ACCESS_KEY=minio
OBJECT_STORAGE_SECRET_KEY=miniosecret
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=miniosecret
MAX_UPLOAD_SIZE_BYTES=10485760
MAX_PDF_PAGES=20
PRESIGNED_URL_EXPIRY_SECONDS=300

# AI (SSAFY GMS; leave keys empty when using demo fallback)
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1
AI_TIMEOUT_SECONDS=45
EMBEDDING_MODEL_NAME=text-embedding-3-small
EMBEDDING_VERSION=v1
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=64
RAG_SEED_INGEST_ON_STARTUP=true
ENABLE_DEMO_FALLBACK=true
RAG_ENABLED=true
RAG_SEARCH_TOP_K=5
RAG_MAX_CONTEXT_CHUNKS=6
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=120
RAG_SCORE_THRESHOLD=0.12
RAG_HISTORY_LIMIT=8

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
