{"id":"term-guaranteed-guests","knowledge_type":"DOMAIN_KNOWLEDGE","title":"보증인원","content":"웨딩홀이 식사·좌석 준비의 최소 기준으로 삼는 인원이다. 확정 방식과 변경 기한은 사용자 계약서를 우선 확인한다.","source":"wedding_domain_terms","scope":"GLOBAL","aliases":["최소 보증인원","보증 하객 수"],"tags":["웨딩홀","하객"],"priority":50,"enabled":true,"version":1,"term":"보증인원","category":"WEDDING_HALL"}
{"id":"term-min-guarantee","knowledge_type":"DOMAIN_KNOWLEDGE","title":"최소 보증인원","content":"업체가 최소 결제를 요구하는 하객 수를 뜻한다. 실제 참석자가 적어도 계약 기준 금액이 적용될 수 있다.","source":"wedding_domain_terms","scope":"GLOBAL","aliases":["보증인원"],"tags":["식대"],"priority":50,"enabled":true,"version":1,"term":"최소 보증인원","category":"WEDDING_HALL"}
{"id":"term-meal-price","knowledge_type":"DOMAIN_KNOWLEDGE","title":"식대","content":"하객 한 명당 식사 비용이다. 메뉴, 음료, 세금 포함 여부는 계약서에서 확인한다.","source":"wedding_domain_terms","scope":"GLOBAL","aliases":["1인 식사비"],"tags":["하객"],"priority":50,"enabled":true,"version":1,"term":"식대","category":"WEDDING_HALL"}
{"id":"term-hall-fee","knowledge_type":"DOMAIN_KNOWLEDGE","title":"대관료","content":"예식 공간을 정해진 시간 동안 사용하는 비용이다. 포함 장비와 연장 비용은 업체별로 다르다.","source":"wedding_domain_terms","scope":"GLOBAL","aliases":["홀 사용료"],"tags":["웨딩홀"],"priority":50,"enabled":true,"version":1,"term":"대관료","category":"WEDDING_HALL"}
{"id":"term-deposit","knowledge_type":"DOMAIN_KNOWLEDGE","title":"계약금","content":"계약 체결 시 먼저 지급하는 금액이다. 반환 여부는 취소 시점과 계약서 환불 규정을 우선한다.","source":"wedding_domain_terms","scope":"GLOBAL","aliases":["예약금"],"tags":["지급"],"priority":50,"enabled":true,"version":1,"term":"계약금","category":"CONTRACT"}
{"id":"term-interim","knowledge_type":"DOMAIN_KNOWLEDGE","title":"중도금","content":"계약금 이후 잔금 전에 나누어 지급하는 금액이다. 지급일과 금액은 계약서 일정을 확인한다.","source":"wedding_domain_terms","scope":"GLOBAL","aliases":[],"tags":["지급"],"priority":50,"enabled":true,"version":1,"term":"중도금","category":"CONTRACT"}
{"id":"term-balance","knowledge_type":"DOMAIN_KNOWLEDGE","title":"잔금","content":"계약 대금에서 이미 낸 금액을 제외한 마지막 지급액이다. 최종 정산 조건은 계약서에 따른다.","source":"wedding_domain_terms","scope":"GLOBAL","aliases":["최종금"],"tags":["지급"],"priority":50,"enabled":true,"version":1,"term":"잔금","category":"CONTRACT"}
{"id":"term-penalty","knowledge_type":"DOMAIN_KNOWLEDGE","title":"위약금","content":"계약 위반이나 취소 시 약정에 따라 부담할 수 있는 금액이다. 구체 기준은 해당 계약서 조항을 확인한다.","source":"wedding_domain_terms","scope":"GLOBAL","aliases":["취소 수수료"],"tags":["취소"],"priority":50,"enabled":true,"version":1,"term":"위약금","category":"CONTRACT"}
{"id":"term-refund-policy","knowledge_type":"DOMAIN_KNOWLEDGE","title":"환불 규정","content":"취소 시 반환 가능한 금액과 공제 조건을 정한 기준이다. 사용자 계약서와 취소 요청일을 함께 확인한다.","source":"wedding_domain_terms","scope":"GLOBAL","aliases":["환급 규정"],"tags":["환불"],"priority":50,"enabled":true,"version":1,"term":"환불 규정","category":"CONTRACT"}
{"id":"term-special","knowledge_type":"DOMAIN_KNOWLEDGE","title":"특약사항","content":"당사자가 개별적으로 합의한 추가 조건이다. 본문과 충돌할 때의 우선순위는 계약 내용을 확인한다.","source":"wedding_domain_terms","scope":"GLOBAL","aliases":["특약"],"tags":["계약"],"priority":50,"enabled":true,"version":1,"term":"특약사항","category":"CONTRACT"}
{"id":"term-cancel","knowledge_type":"DOMAIN_KNOWLEDGE","title":"계약 해제","content":"계약 관계를 종료시키는 절차를 뜻한다. 요건과 효과는 계약서 및 구체 상황을 확인해야 한다.","source":"wedding_domain_terms","scope":"GLOBAL","aliases":["계약 취소"],"tags":["취소"],"priority":50,"enabled":true,"version":1,"term":"계약 해제","category":"CONTRACT"}
{"id":"term-schedule","knowledge_type":"DOMAIN_KNOWLEDGE","title":"일정 변경","content":"예식이나 서비스 제공 날짜를 바꾸는 것이다. 가능 기한, 수수료, 대체 날짜는 업체 계약을 우선한다.","source":"wedding_domain_terms","scope":"GLOBAL","aliases":["날짜 변경"],"tags":["일정"],"priority":50,"enabled":true,"version":1,"term":"일정 변경","category":"CONTRACT"}
{"id":"term-sdm","knowledge_type":"DOMAIN_KNOWLEDGE","title":"스드메","content":"스튜디오·드레스·메이크업 서비스를 묶어 부르는 말이다.","source":"wedding_domain_terms","scope":"GLOBAL","aliases":["스튜디오 드레스 메이크업"],"tags":["패키지"],"priority":50,"enabled":true,"version":1,"term":"스드메","category":"PACKAGE"}
{"id":"term-original","knowledge_type":"DOMAIN_KNOWLEDGE","title":"원본 구매","content":"촬영 결과의 원본 파일을 별도로 받는 선택 항목이다. 파일 범위와 보관 기간은 계약서에 따라 다르다.","source":"wedding_domain_terms","scope":"GLOBAL","aliases":["촬영 원본"],"tags":["스튜디오"],"priority":50,"enabled":true,"version":1,"term":"원본 구매","category":"STUDIO"}
{"id":"term-retouched","knowledge_type":"DOMAIN_KNOWLEDGE","title":"수정본","content":"색감이나 피부 등을 보정한 촬영 결과물이다. 제공 장수와 수정 범위는 상품 구성을 확인한다.","source":"wedding_domain_terms","scope":"GLOBAL","aliases":["보정본"],"tags":["스튜디오"],"priority":50,"enabled":true,"version":1,"term":"수정본","category":"STUDIO"}
{"id":"term-dress-grade","knowledge_type":"DOMAIN_KNOWLEDGE","title":"드레스 등급","content":"소재나 브랜드 등에 따라 드레스를 구분한 상품 단계다. 상위 등급 선택 시 추가금이 있을 수 있다.","source":"wedding_domain_terms","scope":"GLOBAL","aliases":["드레스 라인"],"tags":["드레스"],"priority":50,"enabled":true,"version":1,"term":"드레스 등급","category":"DRESS"}
{"id":"term-main-snap","knowledge_type":"DOMAIN_KNOWLEDGE","title":"본식 스냅","content":"예식 당일의 준비 과정과 본식을 기록하는 사진 촬영 서비스다.","source":"wedding_domain_terms","scope":"GLOBAL","aliases":["예식 스냅"],"tags":["촬영"],"priority":50,"enabled":true,"version":1,"term":"본식 스냅","category":"PHOTO"}
{"id":"term-rehearsal","knowledge_type":"DOMAIN_KNOWLEDGE","title":"리허설 촬영","content":"본식 전에 별도 일정으로 진행하는 웨딩 촬영이다. 의상 수와 촬영 시간은 상품별로 다르다.","source":"wedding_domain_terms","scope":"GLOBAL","aliases":["사전 촬영"],"tags":["스튜디오"],"priority":50,"enabled":true,"version":1,"term":"리허설 촬영","category":"STUDIO"}
{"id":"term-plate","knowledge_type":"DOMAIN_KNOWLEDGE","title":"플레이트 비용","content":"앨범 구성이나 인쇄 판형 변경 등과 관련해 쓰일 수 있는 비용 표현이다. 정확한 항목은 견적서를 확인한다.","source":"wedding_domain_terms","scope":"GLOBAL","aliases":["앨범 판형 비용"],"tags":["앨범"],"priority":50,"enabled":true,"version":1,"term":"플레이트 비용","category":"STUDIO"}
{"id":"term-helper","knowledge_type":"DOMAIN_KNOWLEDGE","title":"헬퍼비","content":"드레스 착용과 이동을 돕는 인력 서비스 비용이다. 시간과 장소에 따라 추가 비용이 있을 수 있다.","source":"wedding_domain_terms","scope":"GLOBAL","aliases":["드레스 헬퍼 비용"],"tags":["드레스"],"priority":50,"enabled":true,"version":1,"term":"헬퍼비","category":"DRESS"}
{"id":"term-partner","knowledge_type":"DOMAIN_KNOWLEDGE","title":"지정 업체","content":"패키지나 웨딩홀이 이용 대상으로 정한 제휴 업체다. 외부 업체 이용 조건은 계약서를 확인한다.","source":"wedding_domain_terms","scope":"GLOBAL","aliases":["제휴 업체"],"tags":["업체"],"priority":50,"enabled":true,"version":1,"term":"지정 업체","category":"VENDOR"}
{"id":"term-outside-fee","knowledge_type":"DOMAIN_KNOWLEDGE","title":"외부 업체 반입비","content":"지정 업체가 아닌 외부 서비스를 이용할 때 부과될 수 있는 비용이다. 허용 여부와 금액은 계약을 따른다.","source":"wedding_domain_terms","scope":"GLOBAL","aliases":["외부업체 비용"],"tags":["업체"],"priority":50,"enabled":true,"version":1,"term":"외부 업체 반입비","category":"VENDOR"}
{"id":"term-early-makeup","knowledge_type":"DOMAIN_KNOWLEDGE","title":"얼리 메이크업","content":"통상 영업 시작 시간보다 이르게 진행하는 메이크업이다. 시작 시간에 따른 추가금이 있을 수 있다.","source":"wedding_domain_terms","scope":"GLOBAL","aliases":["새벽 메이크업"],"tags":["메이크업"],"priority":50,"enabled":true,"version":1,"term":"얼리 메이크업","category":"MAKEUP"}
{"id":"term-extra-fee","knowledge_type":"DOMAIN_KNOWLEDGE","title":"추가금","content":"기본 상품에 포함되지 않은 선택이나 조건으로 발생하는 비용이다. 발생 조건과 단가를 계약서에서 확인한다.","source":"wedding_domain_terms","scope":"GLOBAL","aliases":["옵션 비용"],"tags":["비용"],"priority":50,"enabled":true,"version":1,"term":"추가금","category":"CONTRACT"}
{"id":"term-final-count","knowledge_type":"DOMAIN_KNOWLEDGE","title":"최종 인원 확정","content":"예식 전 실제 준비에 사용할 하객 수를 업체에 최종 통보하는 절차다. 변경 마감일은 계약서를 따른다.","source":"wedding_domain_terms","scope":"GLOBAL","aliases":["하객 수 확정"],"tags":["보증인원"],"priority":50,"enabled":true,"version":1,"term":"최종 인원 확정","category":"WEDDING_HALL"}
